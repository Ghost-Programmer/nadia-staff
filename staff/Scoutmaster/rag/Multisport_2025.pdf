   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">HAWRELAK PARK, CANADA - JULY 18:  A general view of the start of the Mens Triathlon taken during the 2001 World Triathlon Championships on July 18,2001 in Hawrelak Park, Edmonton, Canada. (Photo by: Brian Bahr/Getty Images)</rdf:li>
    </rdf:Alt>
