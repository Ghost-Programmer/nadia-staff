   <dc:subject>
    <rdf:Bag>
     <rdf:li>camping; hiking; canoeing</rdf:li>
     <rdf:li>biking</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">&#xA;General: Troop 141 from Christiansburg, Va. covers more than 100 miles hiking the Appalachian Trail, canoeing the Shenandoah River and biking the C&amp;O Canal towpath all the way to Washington D.C.&#xA;&#xA;Contacts: Scoutmaster Mike Abbott: 540-998-9917, troop.141.brmc.bsa@gmail.com, flying.hokie@gmail.com</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>W. Garth Dowling</rdf:li>
    </rdf:Seq>
   </dc:creator>
