   <dc:subject>
    <rdf:Bag>
     <rdf:li>xFile 07170; 07170; bicycling; touring; Eagle Scouts; ESCAA; Eagle Scouts Cycling Across America</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Phillip Bolick (15, Life, TR 222 of Abingdon, Va) rehydrates during a rest stop.&#xA;&#xA;&#xA;General: Eagle Scouts and near Eagle Scouts Cycle Across the Country. Photos taken from outside of Gillette, Wyo. to Rapid City, S.D.&#xA;Contact: Bruce White 540-379-1181c; email: htcdigtree@aol.com</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>W. Garth Dowling</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Â©2018 Boy Scouts of America / W. Garth Dowling photographer</rdf:li>
    </rdf:Alt>
   </dc:rights>
