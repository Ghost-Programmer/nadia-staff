   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">"CATALINA ISLAND CALIFORNIA WATER SAILBOAT SAILING WATER-SKIING SUNSET WOODCARVING HANDICAPPED CRAFTS BASKET WEAVING KAYAKING LIFEJACKETS BEACH SWIMMING LESSONS INSTRUCTION CANOEING FACES PORTRAITS LIFESAVING TECHNIQUES DIVING SNORKELING SCUBA DIVING NIGHT CAMPFIRE ROWBOAT MEETING FLAG RAISING BUDDY BOARD (CHECK WITH SUBJECT EXPERT ON WOODCARVING AND ANY PADDLING, CANOEING, LIFESAVING)"</rdf:li>
    </rdf:Alt>
